deployment {
  environment dev 'Dev' {
    description 'The only environment that is deployed automatically.'

    host pi 'Raspberry Pi' {
      technology 'linux/arm64, one per smoker'
      description 'Debian trixie arm64. apps/data-pusher/deploy/onboard-pi.sh, run from a laptop, cross-compiles both binaries, copies them over SSH, installs both as systemd units running as the meatgeek user, and enrols the device in DPS. A re-run is how a newer build reaches the Pi (docs/devices/runbook.md).'
      controller = instanceOf meatgeek.edge.controller
      pusher = instanceOf meatgeek.edge.pusher {
        description '''
          DPS mode. `/etc/meatgeek-pusher/env` (0640, root:meatgeek) holds `MEATGEEK_DPS_ID_SCOPE`,
          `MEATGEEK_DEVICE_ID`, `MEATGEEK_STATE_DIR=/var/lib/meatgeek-pusher` and
          `DEVICE_URL=http://localhost:3000`; no connection string and no secret. The device's
          key, certificate, DPS assignment and claim code live under `/var/lib/meatgeek-pusher`
          (0700). Queue at `/var/lib/meatgeek-pusher/queue`, cook state (written only by the
          device twin client) at `cooksession.DefaultStatePath`
          (`/var/lib/meatgeek-pusher/cooksession.json`).
        '''
      }
    }

    resourceGroup rg 'Azure resource group (dev)' {
      technology 'Terraform: apps/infrastructure'
      iothub = instanceOf meatgeek.cloud.ingest.iothub
      dps = instanceOf meatgeek.cloud.ingest.dps {
        description 'meatgeek-v2-dev-dps-259d4bf5b628, S1, linked to the dev hub by its managed identity (no connection string). Enrollments are made by enrol-device.sh, from the laptop or the acceptance jobs.'
      }
      eventhub = instanceOf meatgeek.cloud.ingest.eventhub {
        description 'Event Hub temperature-data, 2 partitions, consumer group api-broadcast, read by the API broadcastTemperature trigger.'
      }
      api = instanceOf meatgeek.cloud.api {
        technology 'Flex Consumption FC1, Node 24, system-assigned managed identity'
        description '''
          App settings: non-secret identity-based endpoints plus the Terraform-owned database and
          container names; the Application Insights connection string is the one exception.
          Easy Auth is default-deny.
        '''
      }
      cosmos = instanceOf meatgeek.cloud.data
      signalr = instanceOf meatgeek.cloud.realtime {
        technology 'service_mode = "Serverless", hub temperatureHub'
      }
      appinsights = instanceOf meatgeek.cloud.observability.appinsights
      logs = instanceOf meatgeek.cloud.observability.logs
      workbook = instanceOf meatgeek.cloud.observability.workbook
      actionGroup = instanceOf meatgeek.cloud.observability.actionGroup
    }

    runner ci 'GitHub Actions runner' {
      technology 'Deploy Dev App, acceptance and web-acceptance jobs, environment development'
      description 'Logs in under OIDC as the dev app-publish identity, which holds IoT Hub Registry Contributor on the dev hub and Device Provisioning Service Data Contributor on the dev DPS (dev only).'
      acceptance = instanceOf delivery.acceptance
      webAcceptance = instanceOf delivery.webAcceptance {
        description 'Playwright with Chromium against the production web app on Vercel, signed in as the TOTP acceptance user.'
      }
      simdevice = instanceOf delivery.simdevice {
        description 'Built per run from apps/data-pusher. Sends as one of the four standing devices: <sim> and <sim>-chart (acceptance job), <sim>-web (web-acceptance job), <sim>-ios (iOS acceptance job, on the macOS runner). Each run gives each device a new X.509 identity in a fresh state dir and enrols its certificate in DPS; no device key leaves the state dir.'
      }
    }

    runner macRunner 'GitHub Actions macOS runner' {
      technology 'macos-26, Xcode 26.6; Deploy Dev App ios-acceptance job, environment development'
      description 'Logs in under OIDC as the same dev app-publish identity, only to enrol and register <sim>-ios; the proof calls the API through the app, as the acceptance user. Builds its own simdevice.'
      iosAcceptance = instanceOf delivery.iosAcceptance
      simulator = instanceOf meatgeek.mobile {
        title 'iOS app (simulator)'
        description 'The real app, built for a throwaway iPhone 17 simulator created for the run and deleted after it, against the dev API.'
      }
    }

    saas vercelHost 'Vercel' {
      technology 'Hobby, Git integration, production branch main'
      web = instanceOf meatgeek.web {
        description 'https://meatgeekv2-web.vercel.app, built by Vercel from every push to main.'
      }
    }

    saas identity 'Microsoft Entra' {
      entra = instanceOf entra
    }
  }
}

views {
  deployment view devDeployment {
    title 'Deployment: dev'
    description 'What runs where. The web app is served by Vercel (production, built from main) and calls the dev API. The iOS app is not distributed: it runs on the iPhone of a developer, from Xcode, and in a simulator on the macOS runner for the ios-acceptance proof. The OTLP collector is not deployed (enable_native_otlp = false); the simulated device runs only on the CI runner, in the dev acceptance jobs.'
    include dev.**
  }
}
