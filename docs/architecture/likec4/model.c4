model {

  pitmaster = actor 'Pitmaster' {
    description 'Runs a cook on a pellet smoker and watches it from a phone or browser.'
  }

  team = actor 'Paperclip team' {
    description 'Lead, Engineer and Reviewer agents. They open, review and merge pull requests.'
  }

  operator = actor 'Operator' {
    description 'Whoever has SSH access to a Pi and owner rights in Azure. Today that is one person at a workstation. Receives the alert and budget email.'
  }

  smoker = external 'Pellet smoker' {
    description 'The physical grill: one grill RTD sensor and four food probes.'
  }

  entra = external 'Microsoft Entra ID' {
    description 'Issues the access tokens that the API accepts: user tokens (access_as_user) to the web app by auth code + PKCE, and app-only tokens to the acceptance suite.'
  }

  vercel = external 'Vercel' {
    description '''
      Hosts the web app. Hobby plan ($0, personal non-commercial use), Git integration,
      production branch `main`: Vercel builds `apps/web` on every push to `main` by itself, with
      no Vercel token in GitHub. It reports to GitHub only through the `Vercel` commit status (no
      GitHub Deployments).
    '''
  }

  meatgeek = system 'MeatGeek V2' {
    description 'BBQ temperature monitoring: readings from the smoker to the cloud, cooks, devices and recipes per user.'

    edge = area 'MeatGeek device' {
      technology 'Raspberry Pi, linux/arm64'
      description 'The MeatGeek hardware: a Raspberry Pi mounted on each smoker and wired to its temperature sensors.'

      controller = app 'device-controller' {
        #live
        technology 'Go / Gobot, local HTTP API on :3000'
        description 'Reads the five RTD sensors (grill and four probes) every 10 ms, averages each over 5 s, and serves the current status on a local HTTP API. At startup it writes a fixed banner to an I2C LCD; the per-probe LCD readout is commented out. Its OpenTelemetry Go SDK samples every span (AlwaysSample) and exports only when OTEL_EXPORTER_OTLP_ENDPOINT is set.'
        link https://github.com/stevebargelt/meatgeekv2/tree/main/apps/device-controller 'Source'
      }

      pusher = app 'data-pusher' {
        #live
        technology 'Go'
        description '''
          Polls the controller, queues readings on disk and publishes them to IoT Hub.
          Learns its active cook from the IoT Hub device twin over the same MQTT connection
          (HAR-58); it has no SignalR client and makes no REST API call.
          Configured by env vars `IOTHUB_CONNECTION_STRING` and `OTEL_EXPORTER_OTLP_ENDPOINT`
          (plus `DEVICE_URL`, `POLL_INTERVAL`, `QUEUE_DIR`, `COOKSESSION_STATE_PATH`).
        '''
        link https://github.com/stevebargelt/meatgeekv2/tree/main/apps/data-pusher 'Source'

        collector = component 'collector' {
          description 'Polls the controller status endpoint every 5 s (POLL_INTERVAL) and stamps each reading with the active cook id and the current correlation id.'
        }
        queue = component 'disk queue' {
          technology '/var/lib/meatgeek-pusher/queue'
          description 'Segment files on disk (QUEUE_DIR), so readings survive a restart or an outage.'
        }
        iot = component 'iothub client' {
          technology 'MQTT on 8883 (paho), device SAS, QoS 1'
          description '''
            `internal/publish` builds each message and `internal/iothub` sends it. Properties on
            every message: `messageId`, `$.ct=application/json`, `$.ce=utf-8`, `correlation.id`
            (cook-scoped) and `traceparent` (per message, from the `publisher.publish` span).
            Renews its SAS token five minutes before expiry. The dev simulated device sends
            through this same code.
          '''
        }
        twin = component 'twin client' {
          #live
          technology 'MQTT twin topics, internal/iothub/twin.go'
          description '''
            Shares the telemetry MQTT connection (IoT Hub allows one per device); it never dials
            its own. On every connect it subscribes to the twin topics and GETs the whole twin,
            so an offline Pi catches up on reconnect. It applies desired patches in `$version`
            order (an older version is ignored; a skipped version triggers a fresh GET),
            persists each to `cooksession`, then reports `activeCookId`, `correlationId` and
            `appliedDesiredVersion`.
          '''
        }
        session = component 'cooksession' {
          technology 'cooksession.Store'
          description '''
            Persists the active cook id, the cook-scoped correlation id and the applied twin
            desired version at `/var/lib/meatgeek-pusher/cooksession.json`, a restart cache so
            a boot with no network still stamps the last cook it was told about. Its only
            writer is the twin client.
          '''
        }
        tracing = component 'telemetry' {
          technology 'OpenTelemetry Go SDK, OTLP/HTTP, AlwaysSample'
          description 'Starts a publisher.publish span per message and injects its traceparent into the message properties. Exports spans only when OTEL_EXPORTER_OTLP_ENDPOINT is set.'
        }

        collector -> queue 'enqueues readings'
        queue -> iot 'drains in order'
        tracing -> iot 'traceparent per message'
        twin -> iot 'shares the MQTT connection'
        twin -> session 'persists active cook, correlation id, applied version'
        session -> collector 'cook id and correlation id'
      }

      pusher.collector -> controller 'GET get_status, every 5 s' {
        technology 'HTTP, local'
        description 'GET /api/robots/MeatGeekBot/commands/get_status on DEVICE_URL (default http://localhost:3000).'
      }

      updater = app 'update agent' {
        #notBuilt
        technology 'Device Update for IoT Hub agent'
        description 'Would receive an update through IoT Hub, install the new packages, restart the services and report the result. Nothing like it runs on the Pi today.'
      }
      updater -[planned]-> controller 'installs, restarts' {
        #notBuilt
      }
      updater -[planned]-> pusher 'installs, restarts' {
        #notBuilt
      }
    }

    cloud = area 'MeatGeek cloud' {
      technology 'Azure, Terraform in apps/infrastructure/modules'
      description 'Everything that runs in Azure: ingest, the API, storage, realtime and observability.'

      deviceupdate = service 'Device Update for IoT Hub' {
        #notBuilt
        description 'Azure over-the-air update service: versions per device, groups, staged rollout, rollback. The direction the owner favours (2026-11-19); not verified in detail and not built.'
      }

      ingest = area 'Ingest' {
        iothub = service 'IoT Hub' {
          #live
          technology 'system-assigned identity'
          description '''
            Two routes on device messages, both with condition `true`: `cosmos-storage-route`
            writes each message into the `temperatures` container (identity-based, partition
            value from `{deviceid}`), and `eventhub-realtime-route` copies it to the Event Hub.
            Device-side senders: the Pi data-pusher, and in dev the simulated device
            `meatgeek-dev-simulated-smoker`.
          '''
        }
        eventhub = stream 'Event Hub: temperature-data' {
          #live
          technology '2 partitions'
          description 'Provisioned and receiving every message. Read by broadcastTemperature in apps/api (HAR-60) on the API consumer group, `api-broadcast` (`TEMPERATURE_BROADCAST_CONSUMER_GROUP`), identity-based.'
        }

        iothub -[event]-> eventhub 'eventhub-realtime-route' {
          technology 'identity-based'
        }
      }

      api = app 'Functions API' {
        #live
        technology 'TypeScript, Node 24, Azure Functions Flex Consumption (FC1)'
        description '''
          HTTP API for cooks, devices, temperatures, recipes and user profiles. Runs under a
          system-assigned managed identity. Its app settings are non-secret identity-based
          endpoints (`COSMOSDB__accountEndpoint`, `IOTHUB_EVENTS__fullyQualifiedNamespace`,
          `AzureSignalRConnectionString__serviceUri`, `AzureWebJobsStorage__accountName`) plus
          the Terraform-owned database and container names (`COSMOSDB_DATABASE_NAME` and one
          `COSMOSDB_*_CONTAINER_NAME` per container), the IoT Hub host
          (`IOTHUB_SERVICE_HOSTNAME`) and its Event Hub consumer group
          (`TEMPERATURE_BROADCAST_CONSUMER_GROUP`). broadcastTemperature reads the consumer group;
          rollupTemperatures reads the `temperatures` change feed with its leases in `leases`
          (`COSMOSDB_LEASES_CONTAINER_NAME`);
          startCook and stopCook read `IOTHUB_SERVICE_HOSTNAME` to write the device twin's
          desired active cook (HAR-66), and claimDevice reads it to check the claim-code hash
          the device reported in its twin and to mark the code consumed (HAR-133), and the
          identity's IoT Hub Twin Contributor grant is on in dev only. The one exception is the Application
          Insights connection string (`APPLICATIONINSIGHTS_CONNECTION_STRING`), with ingestion
          itself authenticated by Entra (`Authorization=AAD`) and sampled at
          `APPLICATIONINSIGHTS_SAMPLING_PERCENTAGE=50`. Apart from it, no connection string or
          key is an app setting or a Terraform output. The Flex deployment package lives in a
          `blobContainer` reached by the same identity (`SystemAssignedIdentity`); the storage
          account has shared keys disabled.
        '''
        link https://github.com/stevebargelt/meatgeekv2/tree/main/apps/api 'Source'

        easyauth = component 'Easy Auth' {
          technology 'App Service Authentication, default-deny'
          description 'requireAuthentication with Return401: validates the Entra token at the platform edge before any function runs, and injects X-MS-CLIENT-PRINCIPAL. Every function is anonymous at the Functions runtime on purpose.'
        }
        principal = component 'principal' {
          description 'The only source of the caller identity: tid:oid from the injected header. Fails closed (401, no default user).'
        }
        cooks = component 'cooks' {
          description 'GET /cooks, POST /cooks, GET /cooks/{cookId}, GET /cooks/{cookId}/chart, POST /cooks/{cookId}/stop'
        }
        devices = component 'devices' {
          description 'GET and POST /devices, POST /devices/claim, GET and PATCH /devices/{id}, and DELETE /devices/{id}, which is release (HAR-136: 409 COOK_ACTIVE while a cook is active; the next claim needs a fresh code)'
        }
        temperatures = component 'temperatures' {
          description 'GET /temperatures/current/{deviceId}, GET /temperatures/history'
        }
        recipes = component 'recipes' {
          description 'GET and POST /recipes, GET, PATCH and DELETE /recipes/{id}'
        }
        users = component 'users' {
          description 'GET and PUT /users/me'
        }
        negotiate = component 'negotiate' {
          technology 'SignalR data-plane REST API, managed identity'
          description 'POST /negotiate: hands the caller a SignalR client token for temperatureHub, minted for its userId (<tid>:<oid>) (MG-30). Its only SignalR call: every message is sent to a userId, so it reads no devices and manages no groups (HAR-81). A deviceId query parameter is ignored.'
        }
        health = component 'health' {
          description 'GET /health/cosmos, and the storageHeartbeat timer that proves host storage authenticates.'
        }
        ownership = component 'ownership check' {
          technology 'getDeviceOwnership'
          description '''
            One point read on `devices` (partition = device id) in `DevicesRepository`.
            A device the caller does not own and one that does not exist get the same answer,
            so the response does not reveal which.
          '''
        }
        repos = component 'cosmos repositories' {
          description 'One repository per container, over a shared adapter that uses the managed identity.'
        }
        otel = component 'telemetry' {
          technology '@azure/monitor-opentelemetry, samplingRatio 0.5'
        }
        broadcast = component 'realtime broadcast' {
          technology 'Event Hub trigger, cardinality many; SignalR output binding'
          description 'broadcastTemperature (HAR-60): sends each reading on temperature-data to the userId of the device owner (HAR-81: one point read of the device per batch), the device taken from the hub-stamped iothub-connection-device-id, the reading mapped by toTemperatureReading (the same mapper as GET /temperatures/current) plus enqueuedTimeUtc. Bad events are skipped and counted, never thrown.'
        }
        rollup = component 'rollupTemperatures' {
          technology 'Cosmos DB change-feed trigger, identity-based, startFromBeginning'
          description '''
            The cook chart's read model (HAR-86). Folds each change-feed batch from `temperatures`
            in memory per device-hour document, then does one etag read-merge-replace per document
            (`If-Match`; a 412 or a 409 re-reads and merges again). At-least-once: a batch written
            but not checkpointed is folded again, which can double-count `n` and `sum` for one
            slot; `min` and `max` are unaffected. Accepted, see temperature-rollups-repository.ts.
          '''
        }

        easyauth -> principal 'X-MS-CLIENT-PRINCIPAL'
        principal -> cooks 'userId'
        principal -> devices 'userId'
        principal -> temperatures 'userId'
        principal -> recipes 'userId'
        principal -> users 'userId'
        cooks -> ownership 'start, stop: 403 DEVICE_NOT_OWNED' {
          description 'A foreign or unregistered device gets 403 DEVICE_NOT_OWNED: no write, no event.'
        }
        devices -> ownership 'GET, PATCH /devices/{id}: 404' {
          description 'Foreign and unknown both answer 404 (error code NOT_FOUND).'
        }
        devices -> ownership 'DELETE /devices/{id}: 403 or 404' {
          description 'HAR-85: a foreign device is 403 DEVICE_NOT_OWNED and is not deleted; an unknown one is 404 DEVICE_NOT_FOUND. The device document alone is deleted: its cooks stay, its readings expire on the TTL.'
        }
        temperatures -> ownership 'current, history: 404 DEVICE_NOT_FOUND'
        cooks -> repos 'write cook'
        cooks -> repos 'chart: cook point read + one single-partition rollup query'
        devices -> repos 'list by userId, register, update, delete'
        temperatures -> repos 'query readings'
        recipes -> repos
        users -> repos
        health -> repos 'probe'
      }

      data = store 'Cosmos DB' {
        #live
        technology 'Cosmos DB for NoSQL, one shared-throughput database'
        description 'Seven containers in one shared-throughput database (400 RU/s), its name Terraform-owned (COSMOSDB_DATABASE_NAME = module.cosmos_db.destination_database_name, the MG-53 shared-throughput destination that the MG-62 cutover moved both dev consumers onto). The setting has no default, so the app can never be deployed pointed at a database that does not exist (MG-51). Access by managed identity only.'

        devices = collection 'devices' {
          technology 'partition /id'
          description 'Read by the ownership check (getDeviceOwnership) with one point read.'
        }
        temperatures = collection 'temperatures' {
          technology 'partition /deviceId'
          description '''
            Only writer: IoT Hub `cosmos-storage-route`, partition value from `{deviceid}` (the
            authenticated device, never the payload). Device-side writers: the Pi data-pusher
            and, in dev, the simulated device. The API only reads it. Readings expire by
            container `default_ttl` = `temperature_data_ttl_days` × 86400 s (dev 7 days,
            prod 90).
          '''
        }
        cooks = collection 'cooks' {
          technology 'partition /userId'
        }
        users = collection 'users' {
          technology 'partition /id'
        }
        recipes = collection 'recipes' {
          technology 'partition /userId'
        }
        temperatureRollups = collection 'temperature-rollups' {
          technology 'partition /deviceId'
          description '''
            One document per device-hour, id `<deviceId>:<yyyy-mm-ddThh>` (UTC): up to 60 minute
            slots, each `{n, min, max, sum}` per channel. No TTL, so a chart outlives the raw
            readings. Written only by `rollupTemperatures`; read only by `GET /cooks/{cookId}/chart`.
          '''
        }
        leases = collection 'leases' {
          technology 'partition /id'
          description 'The change-feed trigger lease container, Terraform-owned (data-plane RBAC cannot create containers, so the trigger never creates it).'
        }
      }

      realtime = service 'SignalR Service' {
        #live
        technology 'Serverless mode, hub temperatureHub'
        description '''
          Terraform sets `service_mode = "Serverless"`: no hub server, no upstream. Push to clients
          only, every message to a userId: `broadcastTemperature` sends each reading to the device
          owner, and `cook_started` and `cook_stopped` go to the cook owner (HAR-81; before it,
          readings went to `device-{id}` groups that negotiate filled, MG-30). Proven live by the acceptance proofs: `signalr negotiate` (a
          client connects with the token the API mints), `signalr live temperature` (a simulated
          reading reaches its owner by push, `METRIC signalr-delivery-ms` 18424 in run
          44673261258) and `signalr isolation` (a non-owner receives nothing, while the owner
          receives the reading and its `cook_started` and `cook_stopped`). The web app's live panel
          is a live client in production: the web-acceptance proof sees a pushed reading in the
          browser (`METRIC web-push-ms` 510, run 44837747351). The device holds no SignalR
          connection.
        '''
      }

      observability = area 'Observability' {
        appinsights = service 'Application Insights' {
          technology 'workspace-based'
        }
        logs = service 'Log Analytics' {
          technology '2 GB/day ingestion cap'
          description 'Diagnostic settings from IoT Hub, Cosmos, SignalR and the Function App. The daily cap (ingestion_cap_gb = 2) is the guardrail against runaway monitoring cost.'
        }
        workbook = service 'Workbook' {
          description 'An Application Insights workbook over the same data.'
        }
        collector = service 'OTLP collector' {
          #scaffold
          technology 'Container App, native-otlp module'
          description 'Terraform is on main but count-guarded off (enable_native_otlp = false). No span from the Pi has reached App Insights.'
        }
        metricAlerts = service 'Metric alerts' {
          description 'function-failure-rate (App Insights requests/failed), cosmos-429-rate (Cosmos TotalRequests, StatusCode 429), signalr-connection-failure-rate (SignalR SystemErrors), ingestion-cap-reached (workspace Heartbeat).'
        }
        activityAlerts = service 'Activity-log alerts' {
          description 'role-assignment-write, user-assigned-identity-write, cosmos-sql-role-assignment-write.'
        }
        actionGroup = service 'Action group' {
          technology 'email receiver'
          description 'The one action group every alert notifies.'
        }
        budgets = service 'Budgets' {
          technology '80 and 100 percent'
          description 'A resource-group budget, and a subscription credit budget only when manage_subscription_budget is set (false in dev and prod). They email through their own contact_emails, not the action group.'
        }

        collector -[planned]-> appinsights 'native OTLP' {
          #notBuilt
        }
        appinsights -> logs 'stores in'
        workbook -> appinsights 'queries'
        appinsights -> metricAlerts 'function-failure-rate'
        logs -> metricAlerts 'ingestion-cap-reached'
        metricAlerts -> actionGroup 'four metric alerts'
        activityAlerts -> actionGroup 'three activity-log alerts'
      }
    }

    mobile = mobileapp 'iOS app' {
      #decided
      technology 'Swift (native iOS)'
      description '''
        Decided by the owner on 2026-11-19 as the next goal, and not built: nothing for it is on
        `main`. It shares only the OpenAPI contract with the web app and will generate its client
        with swift-openapi-generator. The earlier mobile app was removed in HAR-73.
      '''
    }
    web = webapp 'Web app' {
      #live
      technology 'React 18, Vite, TypeScript; MSAL (auth code + PKCE); openapi-fetch with types generated from libs/api-specs/spec; @microsoft/signalr 8.0.17; recharts'
      description '''
        Sign in with Entra; list, register and rename devices; start and stop a cook; list cooks,
        paged by continuation token; a cook's detail page with a live panel by push and a chart of
        the whole cook. Hosted on Vercel production (`https://meatgeekv2-web.vercel.app`), built by
        Vercel's Git integration from `main`; there is no Vercel token in GitHub. Its runtime
        config is `/config.json`, fetched before the app renders.
      '''
      link https://github.com/stevebargelt/meatgeekv2/tree/main/apps/web 'Source'

      shell = component 'shell' {
        technology '@azure/msal-browser, openapi-fetch'
        description 'Fetches and validates `/config.json`, signs in with MSAL (auth code + PKCE, no client secret) and builds the one API client, which adds `Authorization: Bearer <token>` from `acquireTokenSilent` and an `X-Request-ID` to every call.'
      }
      devices = component 'devices' {
        description 'Devices page: GET /devices with one GET /cooks?status=active for the page, register (POST /devices) and rename (PATCH /devices/{id}).'
      }
      cooks = component 'cooks' {
        description 'Cooks list (GET /cooks, "Load more" by continuation token), the start form (POST /cooks with a client-generated id, one per intent, so a retry is idempotent), the cook detail page (GET /cooks/{cookId}) and stop (POST /cooks/{cookId}/stop).'
      }
      livePanel = component 'live panel' {
        technology '@microsoft/signalr 8.0.17'
        description '''
          POST /negotiate, then one hub connection with `withAutomaticReconnect`; when that gives
          up and the connection closes it negotiates again with backoff (2, 5, 10, then 30 s).
          After every connect and reconnect it backfills from
          `GET /temperatures/current/{deviceId}`. States: `waiting` (no reading yet), `live`, and
          `stale` (no reading for 3 x the device `pollingInterval`, or reconnecting).
        '''
      }
      chart = component 'chart' {
        technology 'recharts'
        description 'GET /cooks/{cookId}/chart: one avg line per channel with a min/max band, from the server-side rollups. Readings pushed to the live panel are appended to it.'
      }

      livePanel -> chart 'pushed readings'
      cooks -> livePanel 'the cook device'
      cooks -> chart 'the cook'
    }

    // Telemetry: the storage path is live end to end.
    edge.pusher.iot -[event]-> cloud.ingest.iothub 'telemetry: messageId, $.ct=application/json, $.ce=utf-8, correlation.id, traceparent' {
      technology 'MQTT 8883, device SAS, QoS 1'
      description 'Each reading as JSON with message properties messageId, $.ct=application/json, $.ce=utf-8, correlation.id (cook-scoped, from cooksession) and traceparent (per message, from the publisher.publish span). No Function reads traceparent back.'
    }
    cloud.ingest.iothub -[event]-> cloud.data.temperatures 'cosmos-storage-route' {
      technology 'identity-based, no Function in the path'
      description 'The only writer of temperatures. Partition value from {deviceid}.'
    }

    // Client connections (MG-30): negotiate mints a token for the caller's userId; no groups (HAR-81).
    cloud.api.negotiate -> cloud.realtime 'mint client token for the caller' {
      technology 'REST api-version 2024-12-01, managed identity'
    }
    cloud.api.broadcast -> cloud.api.repos 'owner of each device in the batch'

    // Realtime path: push to clients. Event Hub -> Function -> SignalR (HAR-60), live.
    cloud.ingest.eventhub -[event]-> cloud.api.broadcast 'Event Hub trigger' {
      technology 'consumer group api-broadcast, identity-based'
    }
    cloud.api.broadcast -> cloud.realtime 'each reading, to its device owner' {
      technology 'SignalR output binding, target temperature'
    }
    cloud.realtime -> web.livePanel 'temperature, cook_stopped' {
      technology 'WebSockets, @microsoft/signalr'
    }

    // The active cook is device state, carried by the IoT Hub device twin (HAR-58, HAR-66).
    cloud.api.cooks -> cloud.ingest.iothub 'set twin desired properties' {
      technology 'IoT Hub service REST, managed identity (IoT Hub Twin Contributor)'
      description 'Desired activeCookId and correlationId, synced after the Cosmos write to the device lock under the twin etag (If-Match), so the twin follows Cosmos. A failed sync answers 503 DEVICE_TWIN_UPDATE_FAILED; the cook stays written and a retry of the same request heals the twin.'
    }
    // Claiming a device proves possession through the twin (HAR-130, HAR-133).
    cloud.api.devices -> cloud.ingest.iothub 'read twin claim hash; set desired claim properties' {
      technology 'IoT Hub service REST, managed identity (IoT Hub Twin Contributor)'
      description 'POST /devices/claim reads the twin and compares the reported claimCodeHash (written only by the device, with its own credential) to the hash of the submitted code, in constant time, and checks reported claimGeneration against desired and claimExpiresAt against the clock. It then patches desired claimConsumedCodeHash and claimClaimantHash under the read etag (If-Match), before the Cosmos create, so a code is single-use under concurrency; a 412 re-reads once. A twin read or write failure answers 503 DEVICE_TWIN_UPDATE_FAILED; every refusal is the same 403 CLAIM_REFUSED. Release (DELETE /devices/{id}, HAR-136) reads the twin and patches desired claimGeneration to its value + 1 and claimClaimantHash to null under If-Match (a 412 re-reads once), keeping claimConsumedCodeHash, before the document is deleted, so the device mints a fresh code and the old one can never claim again; a device with no twin (IoT Hub 404) skips it, and any other twin failure answers 503 DEVICE_TWIN_UPDATE_FAILED with the document kept.'
    }
    cloud.ingest.iothub -> edge.pusher.twin 'desired properties' {
      description 'Read in full on every connect and patched on every change, so a Pi that was offline when the cook started gets it on reconnect.'
    }
    edge.pusher.twin -> cloud.ingest.iothub 'reported properties' {
      description 'activeCookId, correlationId and appliedDesiredVersion: what the Pi applied, so the cloud can see it took effect.'
    }

    // Cook lifecycle.
    cloud.api.cooks -[event]-> cloud.realtime 'cook_started, cook_stopped to the owning userId' {
      technology 'SignalR output binding, hub temperatureHub'
      description 'Emitted only after the Cosmos write succeeds. The envelope carries CorrelationContext { id }: the correlation.id the Pi stamps on every reading for the rest of the cook.'
    }

    // Chart read model (HAR-86): the change feed folds readings into hourly rollups.
    cloud.data.temperatures -[event]-> cloud.api.rollup 'change feed (leases)' {
      technology 'Cosmos DB trigger, managed identity'
    }
    cloud.api.rollup -> cloud.data.temperatureRollups 'read-merge-replace, If-Match'
    cloud.api.rollup -> cloud.data.leases 'change-feed checkpoints'
    cloud.api.repos -> cloud.data.temperatureRollups 'chart query; partition = deviceId' {
      description 'One single-partition query over the hours the cook covers (about 13 documents for a 12 h cook), at most 720 points returned.'
    }

    // API to data (partition keys in each container's technology).
    cloud.api.ownership -> cloud.data.devices 'point read'
    cloud.api.repos -> cloud.data.devices 'list by userId, register, update, delete'
    cloud.api.repos -> cloud.data.cooks 'read, write; caller partition'
    cloud.api.repos -> cloud.data.users 'point read, write; id = caller'
    cloud.api.repos -> cloud.data.recipes 'read, write; caller partition'
    cloud.api.repos -> cloud.data.temperatures 'read only; partition = deviceId' {
      description 'Current: newest reading by iothub-enqueuedtime. History: one page per request by continuation token (maxItemCount = limit, at most 1000), with no COUNT and no OFFSET (HAR-75).'
    }

    // Observability.
    cloud.api.otel -> cloud.observability.appinsights 'traces and logs, samplingRatio 0.5'
    edge.pusher.tracing -[planned]-> cloud.observability.collector 'OTLP/HTTP' {
      #notBuilt
      description 'The exporter is in the code; it is a no-op until OTEL_EXPORTER_OTLP_ENDPOINT is set and the collector is switched on.'
    }
    edge.controller -[planned]-> cloud.observability.collector 'OTLP/HTTP' {
      #notBuilt
    }
    cloud.ingest.iothub -> cloud.observability.logs 'diagnostic settings'
    cloud.data -> cloud.observability.logs 'diagnostic settings'
    cloud.realtime -> cloud.observability.logs 'diagnostic settings'
    cloud.api -> cloud.observability.logs 'diagnostic settings'
    cloud.data -> cloud.observability.metricAlerts 'cosmos-429-rate'
    cloud.realtime -> cloud.observability.metricAlerts 'signalr-connection-failure-rate'

    // Web app: live in production on Vercel (HAR-71).
    web -> cloud.api 'REST, user access token (access_as_user)' {
      technology 'HTTPS, openapi-fetch'
      description 'Every call carries the user access token; Easy Auth validates it before any function runs.'
    }
    web.devices -> cloud.api.devices 'GET, POST /devices; PATCH /devices/{id}'
    web.cooks -> cloud.api.cooks 'GET, POST /cooks; GET /cooks/{cookId}; POST /cooks/{cookId}/stop'
    web.shell -> entra 'auth code + PKCE (MSAL), no secret'
    web.livePanel -> cloud.api.negotiate 'POST /negotiate'
    web.livePanel -> cloud.realtime 'connects as the signed-in user' {
      technology 'WebSockets, @microsoft/signalr, withAutomaticReconnect'
    }
    web.livePanel -> cloud.api.temperatures 'GET /temperatures/current/{deviceId} (backfill)'
    web.chart -> cloud.api.cooks 'GET /cooks/{cookId}/chart'

    // iOS app: decided, not built.
    mobile -[decided]-> cloud.api 'REST' {
      #decided
    }
    mobile -[decided]-> cloud.api.negotiate 'negotiate' {
      #decided
    }
    cloud.realtime -[decided]-> mobile 'live temperatures, cook events' {
      #decided
    }
  }

  delivery = system 'Delivery pipeline' {
    description 'GitHub Actions on meatgeekv2. Credentials never meet unmerged code.'

    ci = workflow 'CI/CD Pipeline' {
      description '''
        On every pull request and push to main: lint and test; the Cosmos emulator tests on the
        Windows-native emulator (`api-cosmos-emulator` on `windows-2025`, emulator 2.14.28,
        `PartitionCount=10`; the Linux emulator image crashes natively under load, HAR-113);
        builds, Terraform validation and the security scan; `no-real-time-guard`:
        `node tools/no-real-time/check.mjs`, which fails when a test file adds a real sleep, a
        wall-clock read, a per-wait deadline, a fixed port, or a `| grep -q` under pipefail, with
        a reviewed exception list (HAR-127, HAR-128); and `web-e2e`: Playwright drives the web
        app's main path against the built app, with Entra, the API and SignalR faked at the
        network edge, so it needs no secret and no environment (`contents: read` only). Never
        receives a device credential.
      '''
    }
    testRepeat = workflow 'Test repeat' {
      #live
      technology '.github/workflows/test-repeat.yml, tools/test-repeat'
      description '''
        Runs on pull requests only (opened, synchronize, reopened, labeled), never on `main`,
        with `contents: read` and no secrets. It runs every non-live suite the pull request
        affects 50 times in a row, with Go under `-race`; there are 27 suites, listed in
        `tools/test-repeat/suites.mjs`. Label `test-repeat:all` selects every suite. Label
        `test-repeat:load` adds one pass of 8 concurrent copies. A change to the harness itself
        runs every suite once. Its emulator suite runs on `windows-2025`. It is not a required
        check.
      '''
      link https://github.com/stevebargelt/meatgeekv2/tree/main/tools/test-repeat 'Source'
    }
    apply = workflow 'Apply Dev Infrastructure' {
      description 'Started by a green CI run on main. A run for a superseded commit succeeds without applying.'
    }
    deploy = workflow 'Deploy Dev App' {
      description 'Started by a successful apply. Publishes the API bundle for the commit that was applied, then runs the acceptance and web-acceptance jobs in parallel.'
    }
    acceptance = workflow 'Acceptance' {
      technology 'nx run api:acceptance, environment development'
      description '''
        A job in Deploy Dev App: live probes against the deployed API with an app-only token,
        logged in under OIDC as the dev app-publish identity. There are three standing simulated
        devices: `<sim>` and `<sim>-chart`, which this job ensures, and `<sim>-web`, which the
        web-acceptance job ensures (`<sim>` is `meatgeek-dev-simulated-smoker`). It fetches each
        connection string per run, masks it (the string and its key) and hands it to `simdevice`
        only through an env var (`SIMDEVICE_CONNECTION_STRING`, `SIMDEVICE_CHART_CONNECTION_STRING`).
        It copies every `METRIC` line into the run summary. The proofs live in
        `apps/api/acceptance/proofs/` and run in file-name order: the two telemetry proofs round
        trip first, and the chart proof after both. Every real-time wait in the live suite goes
        through one injectable clock (`apps/api/acceptance/lib/clock.ts`), so the non-live
        self-test runs every wait at its live value on a fake clock. Each wait's bound and reason
        are in the "Real-time waits" table in `docs/development/live-acceptance.md` (HAR-120).
      '''

      roundtrip = component 'telemetry-roundtrip.proof.ts' {
        description 'Registers the simulated device (201, or 409 then GET), sends one reading with simdevice and times it until GET /temperatures/current returns it: METRIC roundtrip-ms.'
      }
      volume = component 'telemetry-volume.proof.ts' {
        description 'Walks the simulated device history by continuation token, tops it up to one long cook of readings (12 h at one every 5 s = 8,640), walks again, and checks the last page costs at most 1.5 x the first.'
      }
      chart = component 'volume-cook-chart.proof.ts' {
        description '''
          Keeps one standing active cook on `<sim>-chart` and never stops it. If its chart does
          not cover 12 h, a one-time top-up of 8,640 readings by `simdevice --start <startTime>
          --step 5s`; rollups have no TTL, so later runs send nothing. Then one more
          `GET /cooks/{cookId}/chart` is the measurement: `METRIC chart-ru-12h` must be at most 40
          (measured 6.19).
        '''
      }
    }

    webAcceptance = workflow 'Web acceptance' {
      technology 'nx e2e-live web-e2e, environment development'
      description '''
        A job in Deploy Dev App, in parallel with `acceptance`: the live browser proof against the
        production web app. It waits for `/version.json` to show the deployed commit (or a
        descendant), signs in on Microsoft's real pages as `ACCEPTANCE_USER_UPN` (password +
        TOTP), registers `<sim>-web`, starts a cook, sees a reading pushed by `simdevice` in the
        live panel, and stops the cook. Prints `METRIC web-deploy-wait-s` and `web-push-ms` (510
        in run 44837747351). When a sign-in step fails, the proof writes a scrubbed
        `sign-in-diagnostic.txt`: URL origin and path, title, which selectors are present, and
        Microsoft's error text. It never contains an input value, the UPN, a password or TOTP, a
        cookie, or a URL query (HAR-121). The leak check runs over the raw log (before masking)
        and that file before the failure upload, and deletes any diagnostic in which it finds
        something (HAR-126). On failure it uploads the `web-acceptance-diagnostics` artifact
        (screenshots taken after sign-in, plus the diagnostic) for 7 days. Playwright's own trace,
        video and screenshots stay off.
      '''
    }

    simdevice = app 'simdevice' {
      #live
      technology 'Go, apps/data-pusher/cmd/simdevice'
      description '''
        A software IoT Hub device for dev. It sends synthetic readings as any of the three standing
        devices (`<sim>` = `meatgeek-dev-simulated-smoker`, `<sim>-chart`, `<sim>-web`) through
        the data-pusher's own `internal/publish` and
        `internal/iothub` code: MQTT on 8883, device SAS, QoS 1, with `messageId`,
        `$.ct=application/json`, `$.ce=utf-8` and a per-reading `traceparent` (span
        `simdevice.publish`), as the Pi's readings carry. Unlike the Pi, it sends no
        `correlation.id` and no cook id: it has no cook. Readings carry the wall-clock time unless
        `--start/--step` stamps synthetic timestamps (reading i at start + i x step). Built and
        spawned per run by the acceptance and web-acceptance jobs. Its credential
        reaches it only via an env var, fetched per run under
        OIDC as the dev app-publish identity and masked. It is never stored (no repo secret, no
        Key Vault, no hub shared-access policy) and never passed to PR CI.
      '''
      link https://github.com/stevebargelt/meatgeekv2/tree/main/apps/data-pusher/cmd/simdevice 'Source'
    }

    ci -[event]-> apply 'workflow_run, main only'
    apply -[event]-> deploy 'workflow_run'
    deploy -> acceptance 'needs: deploy'
    deploy -> webAcceptance 'needs: deploy'
    acceptance.roundtrip -> simdevice 'spawns: --count 1'
    acceptance.volume -> simdevice 'spawns: top-up to 8,640 readings'
    acceptance.chart -> simdevice 'spawns as <sim>-chart, --start/--step'
    webAcceptance -> simdevice 'spawns as <sim>-web'
  }

  // Device software updates. Today: by hand. Not built: over the air.
  operator -> meatgeek.edge.pusher 'make deploy-to-pi' {
    technology 'scp, then systemd restart, over SSH'
    description 'The only way a new build reaches a Pi today. One device at a time, from a machine that can reach it.'
  }
  operator -> meatgeek.edge.controller 'make deploy-to-pi' {
    technology 'scp, then systemd restart, over SSH'
  }
  delivery.ci -[planned]-> meatgeek.cloud.deviceupdate 'publishes signed packages' {
    #notBuilt
    description 'CI already builds the ARM64 binaries on every merge and keeps them as workflow artifacts. Nothing delivers them.'
  }
  meatgeek.cloud.deviceupdate -[planned]-> meatgeek.cloud.ingest.iothub 'deployment to a device group' {
    #notBuilt
  }
  meatgeek.cloud.ingest.iothub -[planned]-> meatgeek.edge.updater 'update available' {
    #notBuilt
  }
  meatgeek.edge.updater -[planned]-> meatgeek.cloud.ingest.iothub 'installed version, result' {
    #notBuilt
  }

  // Simulated device (dev acceptance).
  delivery.simdevice -[event]-> meatgeek.cloud.ingest.iothub 'telemetry as <sim>, <sim>-chart or <sim>-web: messageId, $.ct=application/json, $.ce=utf-8, traceparent' {
    technology 'MQTT 8883, device SAS, QoS 1'
    description 'Built by the internal/publish builders of the data-pusher over the same internal/iothub transport, so messageId, $.ct, $.ce and traceparent match the readings of the Pi. No correlation.id and no cook id: simdevice passes an empty correlation and a nil cook id.'
  }
  delivery.acceptance -> meatgeek.cloud.ingest.iothub 'ensure the device identity, read its connection string' {
    technology 'az iot hub device-identity --auth-type login, OIDC'
    description '''
      As the dev app-publish identity, which holds `IoT Hub Registry Contributor` on the dev hub
      through `azurerm_role_assignment.simulated_device_registry_contributor`. That grant exists
      only when `simulated_device_id` is set (only `dev.tfvars` sets it) and the app-deploy
      principal is known.
    '''
  }
  delivery.acceptance.roundtrip -> meatgeek.cloud.api.devices 'POST /devices: 201, or 409 then GET /devices/{id}'
  delivery.acceptance.roundtrip -> meatgeek.cloud.api.temperatures 'GET /temperatures/current/{id}, then history'
  delivery.acceptance.volume -> meatgeek.cloud.api.temperatures 'GET /temperatures/history: two walks by continuation token'
  delivery.acceptance.chart -> meatgeek.cloud.api.cooks 'GET /cooks/{cookId}/chart'
  delivery.acceptance -> meatgeek.cloud.api.negotiate 'POST /negotiate (signalr proofs)'
  delivery.acceptance -> meatgeek.cloud.realtime 'connects as a SignalR client' {
    technology '@microsoft/signalr'
    description 'The signalr negotiate, signalr live temperature and signalr isolation proofs. They receive temperature, cook_started and cook_stopped.'
  }

  // Landscape.
  pitmaster -> smoker 'cooks on'
  pitmaster -> meatgeek.web 'watches a cook live, reviews cooks'
  pitmaster -[decided]-> meatgeek.mobile 'monitors a cook' {
    #decided
  }
  smoker -> meatgeek.edge.controller 'RTD sensor readings'
  meatgeek.cloud.api.easyauth -> entra 'validates access tokens'
  team -> delivery.ci 'pull requests'
  team -> delivery.testRepeat 'pull requests'
  delivery.apply -> meatgeek 'terraform apply (dev)'
  delivery.deploy -> meatgeek.cloud.api 'publishes the bundle'
  delivery.acceptance -> meatgeek.cloud.api 'live acceptance probes'
  delivery.acceptance -> entra 'app-only token (OIDC)'
  vercel -> meatgeek.web 'builds apps/web on every push to main, serves production'
  delivery.webAcceptance -> meatgeek.web 'Playwright, production'
  delivery.webAcceptance -> entra 'signs in as the test user'
  delivery.webAcceptance -> meatgeek.cloud.ingest.iothub 'ensure <sim>-web, read its connection string' {
    technology 'az iot hub device-identity --auth-type login, OIDC'
  }
  meatgeek.cloud.observability.actionGroup -> operator 'alert email'
  meatgeek.cloud.observability.budgets -> operator 'budget email (contact_emails)'
}
