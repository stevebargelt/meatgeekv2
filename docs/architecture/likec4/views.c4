views {

  // Applied to every view below: fade what is not built.
  style element.tag = #notBuilt {
    color muted
    opacity 15%
    border dotted
  }
  style element.tag = #decided {
    color sky
    border dashed
  }
  style element.tag = #retiring {
    color red
    border dotted
  }
  style element.tag = #scaffold {
    color amber
    opacity 25%
    border dashed
  }

  view index {
    title 'MeatGeek V2: landscape'
    description 'Who uses it, what it depends on, and how changes reach it. MeatGeek V2 is three things: the device on the smoker, the cloud, and the apps. Click a box to go down a level.'
    include *
    include meatgeek.edge, meatgeek.cloud, meatgeek.mobile, meatgeek.web
  }

  view system of meatgeek {
    title 'MeatGeek V2: containers'
    description 'Everything that runs. Sky dashed is decided and not built: the mobile and web apps as SignalR clients. Grey dotted is not built, with no decision.'
    include *
    include edge.*, cloud.*, cloud.ingest.*, cloud.observability.*
    include pitmaster, smoker, entra
    include delivery.simdevice
  }

  view edge of meatgeek.edge {
    title 'MeatGeek device (Raspberry Pi)'
    include *
    include pusher.*
    include meatgeek.cloud.ingest.iothub, meatgeek.cloud.observability.collector
  }

  view cloud of meatgeek.cloud {
    title 'MeatGeek cloud (Azure)'
    include *
    include ingest.*, observability.*
    include api.cooks, api.negotiate, api.broadcast
    include meatgeek.edge, meatgeek.edge.pusher.twin, meatgeek.mobile, meatgeek.web, entra
    include delivery.simdevice, operator
  }

  view api of meatgeek.cloud.api {
    title 'Functions API'
    description '''
      Every route is anonymous at the Functions runtime on purpose: Easy Auth (default-deny,
      Return401) has already validated the token. The cook, device and temperature routes first
      call `getDeviceOwnership`, one point read on `devices`. For a device the caller does not
      own: cooks start/stop answer `403 DEVICE_NOT_OWNED` (no write, no event), `GET`/`PATCH
      /devices/{id}` answer 404, and temperatures current/history answer `404 DEVICE_NOT_FOUND`.
    '''
    include *
    include meatgeek.cloud.data.*, meatgeek.cloud.realtime, entra, meatgeek.cloud.observability.appinsights
    include meatgeek.cloud.ingest.iothub, meatgeek.cloud.ingest.eventhub, meatgeek.edge.pusher.twin
  }

  view data of meatgeek.cloud.data {
    title 'Cosmos DB'
    description '''
      Five containers in one shared-throughput database, their partition keys, and who touches
      each: `devices /id`, `temperatures /deviceId`, `cooks /userId`, `users /id`,
      `recipes /userId`. The ownership check `getDeviceOwnership` is one point read on
      `devices`. IoT Hub's `cosmos-storage-route` is the only writer of `temperatures`, with
      the partition value taken from `{deviceid}`; its device-side writers are the Pi
      data-pusher and the dev simulated device.
    '''
    include *
    include meatgeek.cloud.api.repos, meatgeek.cloud.api.ownership, meatgeek.cloud.ingest.iothub
    include meatgeek.edge.pusher, delivery.simdevice
  }

  view ingest of meatgeek.cloud.ingest {
    title 'Ingest'
    include *
    include meatgeek.edge.pusher, meatgeek.cloud.data.temperatures, meatgeek.cloud.api.broadcast, meatgeek.cloud.realtime
    include delivery.simdevice, delivery.acceptance
  }

  view observability of meatgeek.cloud.observability {
    title 'Observability'
    description '''
      The API exports straight to Application Insights at a 0.5 sampling ratio. The Go
      services sample every span (`AlwaysSample`) and export OTLP/HTTP to the collector, which
      is off by default (`enable_native_otlp = false`); with no `OTEL_EXPORTER_OTLP_ENDPOINT`
      they export nothing. Four metric alerts and three activity-log alerts notify one action
      group; the budgets email through their own `contact_emails`.
    '''
    include *
    include meatgeek.cloud.api, meatgeek.edge.pusher, meatgeek.edge.controller
    include meatgeek.cloud.ingest.iothub, meatgeek.cloud.data, meatgeek.cloud.realtime, operator
  }

  view pipeline of delivery {
    title 'Delivery pipeline'
    include *
    include acceptance.*
    include team, meatgeek, entra
  }

  view deviceUpdates {
    title 'Device software updates'
    description 'How a new build reaches the Pi. Solid: today, by hand over SSH. Grey dotted: over-the-air through Device Update for IoT Hub, not built.'
    include
      operator, delivery.ci,
      meatgeek.edge.controller, meatgeek.edge.pusher, meatgeek.edge.updater,
      meatgeek.cloud.deviceupdate, meatgeek.cloud.ingest.iothub
    exclude meatgeek.edge.pusher <-> meatgeek.cloud.ingest.iothub
    exclude meatgeek.edge.pusher -> meatgeek.edge.controller
  }

  // ---- Flows ---------------------------------------------------------------

  dynamic view telemetry {
    title 'Flow: one temperature reading'
    description '''
      Today. Both paths are live. Storage: IoT Hub's `cosmos-storage-route` writes Cosmos.
      Push: Event Hub, then `broadcastTemperature`, then SignalR, addressed to the device owner.
      No app negotiates or connects to SignalR yet, so the flow stops at SignalR; the only live
      client is the acceptance proofs (`signalr negotiate`, `signalr live temperature`,
      `signalr isolation`). Measured send-to-client delay: `METRIC signalr-delivery-ms` 18424
      (run 44673261258), a single dev sample.
      Two correlation axes ride on each reading. `correlation.id` is cook-scoped: the device
      twin's desired `correlationId` (see `cookStart`), persisted in `cooksession` and stamped
      on every message for the whole cook. `traceparent` is per message, from the
      `publisher.publish` span; no Function reads it back.
    '''

    smoker -> meatgeek.edge.controller 'grill and probe temperatures'
    meatgeek.edge.pusher.collector -> meatgeek.edge.controller 'GET get_status' {
      notes 'Local HTTP poll of `/api/robots/MeatGeekBot/commands/get_status`, every 5 s.'
    }
    meatgeek.edge.pusher.session -> meatgeek.edge.pusher.collector 'active cook id, correlation id' {
      notes '''
        The cook id and correlation id come from one `cooksession` snapshot, the values the twin
        client last applied from the device twin's desired properties (see `cookStart`).
      '''
    }
    meatgeek.edge.pusher.collector -> meatgeek.edge.pusher.queue 'enqueue'
    meatgeek.edge.pusher.queue -> meatgeek.edge.pusher.iot 'drain'
    meatgeek.edge.pusher.tracing -> meatgeek.edge.pusher.iot 'publisher.publish span, traceparent' {
      notes 'Every message gets its own span and `traceparent` (W3C Trace Context), sampled always.'
    }
    meatgeek.edge.pusher.iot -> meatgeek.cloud.ingest.iothub 'publish (MQTT 8883, QoS 1)' {
      notes '''
        Message properties: `messageId`, `$.ct=application/json`, `$.ce=utf-8`,
        `correlation.id` (cook-scoped) and `traceparent` (per message).
        Device SAS, renewed five minutes before it expires.
      '''
    }
    parallel {
      meatgeek.cloud.ingest.iothub -> meatgeek.cloud.data.temperatures 'cosmos-storage-route' {
        notes '**Live.** IoT Hub writes the document itself, by managed identity, partition value from `{deviceid}`. No Function runs, so nothing reads `traceparent` back.'
      }
      meatgeek.cloud.ingest.iothub -> meatgeek.cloud.ingest.eventhub 'eventhub-realtime-route' {
        notes '**Live.** Every message is copied to the `temperature-data` Event Hub.'
      }
    }
    meatgeek.cloud.ingest.eventhub -> meatgeek.cloud.api.broadcast 'Event Hub trigger, consumer group api-broadcast' {
      notes '**Live.** `broadcastTemperature` (HAR-60), `cardinality: many`, identity-based. The device is the hub-stamped `iothub-connection-device-id`; the reading is mapped by `toTemperatureReading`, as `GET /temperatures/current` does, plus `enqueuedTimeUtc`.'
    }
    meatgeek.cloud.api.broadcast -> meatgeek.cloud.realtime 'each reading to its owner' {
      notes '''
        **Live.** SignalR output binding, target `temperature`, hub `temperatureHub`, `userId` =
        the device owner, read once per device per batch (HAR-81). No app connects yet; the
        acceptance proofs are the only live client (`signalr live temperature` measured
        `signalr-delivery-ms` 18424, run 44673261258).
      '''
    }
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.api.repos 'history or current reading' {
      navigateTo readHistory
    }
    meatgeek.cloud.api.repos -> meatgeek.cloud.data.temperatures 'query by deviceId'
  }

  dynamic view cookStart {
    variant sequence
    title 'Flow: start a cook'
    description '''
      POST /cooks as the code does it now. The active cook is device state: the API syncs the
      device twin's desired properties to Cosmos, and the Pi applies them and reports them back
      (HAR-58, HAR-66). The twin persists, so a Pi that is offline when the cook starts gets it
      when it next connects. `cook_started` goes to the owning user's SignalR connections, not
      to the Pi (MG-30); no app receives it yet. Sign-in (Easy Auth, then the principal) and the
      ownership check run first, as in the `api` view. Stopping a cook follows the same path:
      the twin's desired cook is cleared and `cook_stopped` goes to the owner.
    '''

    meatgeek.mobile -> meatgeek.cloud.api.cooks 'POST /cooks' {
      notes '''
        Through Easy Auth and the principal (`userId = tid:oid`; a missing header is 401). The
        ownership check is one point read on `devices`: a foreign or unregistered device gets
        403 `DEVICE_NOT_OWNED`, with no write and no event. The mobile app does not call the
        API yet; the live callers are the acceptance proofs.
      '''
    }
    meatgeek.cloud.api.cooks -> meatgeek.cloud.data.cooks 'cook and device lock' {
      notes 'One transactional batch in the caller partition: the cook and its device lock commit together, so a device holds at most one active cook (MG-84).'
    }
    meatgeek.cloud.api.cooks -> meatgeek.cloud.ingest.iothub 'set desired: activeCookId, correlationId' {
      notes '''
        After the write, synced to the device lock under the twin etag (`If-Match`): GET the
        twin, read the active cook from Cosmos, PATCH only if they differ, then re-read. Managed
        identity with `IoT Hub Twin Contributor`. A failed sync answers 503
        `DEVICE_TWIN_UPDATE_FAILED`; the cook stays written and a retry of the same request
        heals the twin.
      '''
    }
    meatgeek.cloud.ingest.iothub -> meatgeek.edge.pusher.twin 'desired properties' {
      notes 'Delivered on connect (a full GET) or on change (a patch), so an offline Pi catches up. Patches apply in `$version` order.'
    }
    meatgeek.edge.pusher.twin -> meatgeek.edge.pusher.session 'persist cook, correlation id, version' {
      notes 'Written to `/var/lib/meatgeek-pusher/cooksession.json`. From then every reading carries this cook id and correlation id.'
      navigateTo telemetry
    }
    meatgeek.edge.pusher.twin -> meatgeek.cloud.ingest.iothub 'reported: applied' {
      notes '`activeCookId`, `correlationId` and `appliedDesiredVersion`: the acknowledgement. Proven live by the `device twin` acceptance proof, with the device offline when the cook starts.'
    }
    meatgeek.cloud.api.cooks -> meatgeek.cloud.realtime 'cook_started to the owning userId' {
      notes '''
        Sent only after the write succeeds, on hub `temperatureHub`, to the caller's
        `userId` ("<tid>:<oid>"), never to the deviceId (MG-30). The envelope carries
        `correlation: CorrelationContext { id }`, the same id the twin carries. The
        `signalr isolation` proof receives it as the owner; no app consumes it yet.
      '''
    }
  }

  dynamic view readHistory {
    variant sequence
    title 'Flow: read temperature history'
    description 'GET /temperatures/history for a device.'

    meatgeek.mobile -> meatgeek.cloud.api.easyauth 'GET /temperatures/history'
    meatgeek.cloud.api.easyauth -> meatgeek.cloud.api.principal 'X-MS-CLIENT-PRINCIPAL'
    meatgeek.cloud.api.principal -> meatgeek.cloud.api.temperatures 'userId'
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.api.ownership 'does the caller own this device?'
    meatgeek.cloud.api.ownership -> meatgeek.cloud.data.devices 'point read' {
      notes '`getDeviceOwnership`. Not owned or not found: 404 `DEVICE_NOT_FOUND`, about 1 RU.'
    }
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.api.repos 'one page of readings'
    meatgeek.cloud.api.repos -> meatgeek.cloud.data.temperatures 'COUNT(1), then one page; partition = deviceId' {
      notes '''
        Every request pays a `COUNT(1)` over the device partition for `total`, and the page is
        `OFFSET`/`LIMIT`, whose cost grows with the skip. Measured: see `telemetryProof`.
      '''
      navigateTo telemetryProof
    }
  }

  dynamic view telemetryProof {
    variant sequence
    title 'Flow: live telemetry proof (dev acceptance)'
    description '''
      Every Deploy Dev App acceptance job proves the telemetry path end to end:
      `telemetry-roundtrip.proof.ts`, then `telemetry-volume.proof.ts`. `simdevice` sends as
      `meatgeek-dev-simulated-smoker` (MQTT 8883, device SAS, QoS 1, the data-pusher's own
      publish code); no Function is in the write path.

      Measured (single dev samples, not targets): `roundtrip-ms` 1211 (run 44603121177) and
      1235 (run 44612029684); `topup-sent`/`topup-ms` 2175 / 109996 (~19.8 readings/s, run
      44612029684). Before HAR-75 history paged by `OFFSET` and every request paid a `COUNT(1)`:
      in run 44612029684 the 100-reading page cost 11.95 RU at offset 0 and 24.12 RU at offset
      8600. Since HAR-75 it pages by continuation token with no COUNT, and the volume proof fails
      unless the last page of a walk costs at most 1.5 x the first.
    '''

    delivery.acceptance.roundtrip -> meatgeek.cloud.api.devices 'POST /devices (meatgeek-dev-simulated-smoker)' {
      notes 'Register or 409: 201 if new; 409 `DEVICE_CONFLICT` if already registered, then `GET /devices/{id}` must answer 200.'
    }
    delivery.acceptance.roundtrip -> delivery.simdevice 'simdevice --count 1'
    delivery.simdevice -> meatgeek.cloud.ingest.iothub 'one reading, MQTT QoS 1' {
      notes 'Properties `messageId`, `$.ct=application/json`, `$.ce=utf-8`, `traceparent`.'
    }
    meatgeek.cloud.ingest.iothub -> meatgeek.cloud.data.temperatures 'cosmos-storage-route'
    delivery.acceptance.roundtrip -> meatgeek.cloud.api.temperatures 'GET /temperatures/current/{id}' {
      notes 'Polled every 1 s, 120 s cap, until it returns the sent reading. Prints `METRIC roundtrip-ms`: 1211 and 1235.'
    }
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.data.temperatures 'newest reading by iothub-enqueuedtime'
    delivery.acceptance.roundtrip -> meatgeek.cloud.api.temperatures 'GET /temperatures/history?startTime=...' {
      notes 'The page holds the sent reading.'
    }
    delivery.acceptance.volume -> meatgeek.cloud.api.temperatures 'GET /temperatures/history?limit=1000, page by page' {
      notes 'Walks the simulated device by continuation token, one page at a time, to count its readings.'
    }
    delivery.acceptance.volume -> delivery.simdevice 'simdevice --count N --inflight 32 --interval 50ms' {
      notes 'Only if the walk counts fewer than 8,640 (12 h at one every 5 s). N = 8,640 - counted + 60. Measured `topup-sent`/`topup-ms` 2175 / 109996, ~19.8 readings/s.'
    }
    delivery.simdevice -> meatgeek.cloud.ingest.iothub 'N readings, MQTT QoS 1'
    meatgeek.cloud.ingest.iothub -> meatgeek.cloud.data.temperatures 'cosmos-storage-route'
    delivery.acceptance.volume -> meatgeek.cloud.api.temperatures 'GET /temperatures/current/{id}, until the top-up end' {
      notes 'After a top-up only. Polled every 10 s, 15 min cap, until the current reading is at or after the reading 32 places from the top-up last.'
    }
    delivery.acceptance.volume -> meatgeek.cloud.api.temperatures 'the same walk again' {
      notes 'Prints `history-ru-first-page`, `history-ru-last-page` and `history-pages`; fails unless the last page costs at most 1.5 x the first.'
    }
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.data.temperatures 'one page per request: maxItemCount + continuation token' {
      notes 'No COUNT and no OFFSET (HAR-75), so a deep page costs what the first does. The job copies every `METRIC` line into the run summary.'
    }
  }

  dynamic view mergeToDeploy {
    title 'Flow: a merge reaches dev'
    description 'What happens after the Reviewer merges a pull request.'

    team -> delivery.ci 'merge to main' {
      notes 'The push to `main` starts CI/CD Pipeline.'
    }
    delivery.ci -> delivery.apply 'green on main' {
      notes '''
        `workflow_run`, so the workflow file that runs is always the one on `main`.
        If a newer commit has landed, this run ends green **without applying**.
      '''
    }
    delivery.apply -> meatgeek 'terraform apply'
    delivery.apply -> delivery.deploy 'apply succeeded'
    delivery.deploy -> meatgeek 'publish the API bundle'
    delivery.deploy -> delivery.acceptance 'deployed = true'
    delivery.acceptance -> entra 'get app-only token'
    delivery.acceptance -> meatgeek 'live probes against the API'
    delivery.acceptance -> delivery.simdevice 'spawns simdevice' {
      notes 'Live telemetry round trip and volume proofs through IoT Hub.'
      navigateTo telemetryProof
    }
  }
}
