views {

  // Applied to every view below: fade what is not built.
  style element.tag = #notBuilt {
    color muted
    opacity 15%
    border dotted
  }
  style element.tag = #decided {
    color sky
    border dashed
  }
  style element.tag = #retiring {
    color red
    border dotted
  }
  style element.tag = #scaffold {
    color amber
    opacity 25%
    border dashed
  }

  view index {
    title 'MeatGeek V2: landscape'
    description 'Who uses it, what it depends on, and how changes reach it. MeatGeek V2 is three things: the device on the smoker, the cloud, and the apps. Both apps are live: the web app on Vercel, the iOS app from Xcode (not distributed). Nothing is decided and unbuilt; grey dotted is not built, with no decision. Click a box to go down a level.'
    include *
    include meatgeek.edge, meatgeek.cloud, meatgeek.mobile, meatgeek.web
    include vercel
  }

  view system of meatgeek {
    title 'MeatGeek V2: containers'
    description 'Everything that runs. Both apps are live: the web app on Vercel, the iOS app from Xcode against dev (not distributed). Nothing is decided and unbuilt; grey dotted is not built, with no decision.'
    include *
    include edge.*, cloud.*, cloud.ingest.*, cloud.observability.*
    include pitmaster, smoker, entra, vercel
    include delivery.simdevice
  }

  view edge of meatgeek.edge {
    title 'MeatGeek device (Raspberry Pi)'
    include *
    include pusher.*
    include meatgeek.cloud.ingest.iothub, meatgeek.cloud.ingest.dps, meatgeek.cloud.observability.collector
  }

  view cloud of meatgeek.cloud {
    title 'MeatGeek cloud (Azure)'
    include *
    include ingest.*, observability.*
    include api.cooks, api.negotiate, api.broadcast, api.rollup, data.temperatureRollups
    include meatgeek.edge, meatgeek.edge.pusher.twin, meatgeek.mobile, meatgeek.web, entra
    include meatgeek.web.livePanel, meatgeek.web.chart, meatgeek.mobile.livePanel, meatgeek.mobile.chart
    include delivery.simdevice, operator
  }

  view api of meatgeek.cloud.api {
    title 'Functions API'
    description '''
      Every route is anonymous at the Functions runtime on purpose: Easy Auth (default-deny,
      Return401) has already validated the token. The cook, device and temperature routes first
      call `getDeviceOwnership`, one point read on `devices`. For a device the caller does not
      own: cooks start/stop answer `403 DEVICE_NOT_OWNED` (no write, no event), `GET`/`PATCH
      /devices/{id}` answer 404, `DELETE /devices/{id}` answers `403 DEVICE_NOT_OWNED` (nothing
      deleted) and `404 DEVICE_NOT_FOUND` for an unknown device, and temperatures current/history
      answer `404 DEVICE_NOT_FOUND`.
    '''
    include *
    include meatgeek.cloud.data.*, meatgeek.cloud.realtime, entra, meatgeek.cloud.observability.appinsights
    include meatgeek.cloud.ingest.iothub, meatgeek.cloud.ingest.eventhub, meatgeek.edge.pusher.twin
  }

  view data of meatgeek.cloud.data {
    title 'Cosmos DB'
    description '''
      Seven containers in one shared-throughput database (400 RU/s), their partition keys, and
      who touches each: `devices /id`, `temperatures /deviceId`, `cooks /userId`, `users /id`,
      `recipes /userId`, `temperature-rollups /deviceId` and `leases /id`. The ownership check
      `getDeviceOwnership` is one point read on `devices`. IoT Hub's `cosmos-storage-route` is
      the only writer of `temperatures`, with the partition value taken from `{deviceid}`; its
      device-side writers are the Pi data-pusher and the dev simulated device.
      `rollupTemperatures` reads its change feed (checkpoints in `leases`) and is the only
      writer of `temperature-rollups`, which the cook chart reads.
    '''
    include *
    include meatgeek.cloud.api.repos, meatgeek.cloud.api.ownership, meatgeek.cloud.ingest.iothub
    include meatgeek.cloud.api.rollup
    include meatgeek.edge.pusher, delivery.simdevice
  }

  view ingest of meatgeek.cloud.ingest {
    title 'Ingest'
    include *
    include meatgeek.edge.pusher, meatgeek.cloud.data.temperatures, meatgeek.cloud.api.broadcast, meatgeek.cloud.realtime
    include delivery.simdevice, delivery.acceptance, operator
  }

  view observability of meatgeek.cloud.observability {
    title 'Observability'
    description '''
      The API exports straight to Application Insights at a 0.5 sampling ratio. The Go
      services sample every span (`AlwaysSample`) and export OTLP/HTTP to the collector, which
      is off by default (`enable_native_otlp = false`); with no `OTEL_EXPORTER_OTLP_ENDPOINT`
      they export nothing. Three metric alerts, two log search alerts and three activity-log
      alerts notify one action group; the budgets email through their own `contact_emails`.
    '''
    include *
    include meatgeek.cloud.api, meatgeek.edge.pusher, meatgeek.edge.controller
    include meatgeek.cloud.ingest.iothub, meatgeek.cloud.data, meatgeek.cloud.realtime, operator
  }

  view pipeline of delivery {
    title 'Delivery pipeline'
    description '''
      Pull requests feed two workflows. CI/CD Pipeline runs on every pull request and push to
      main: lint and test, the Cosmos emulator tests on `windows-2025`, builds, Terraform
      validation, the security scan, the `no-real-time` guard, `web-e2e` and `ios`. Test repeat
      (`test-repeat.yml`) runs on pull requests only: each affected non-live suite 50 times in a
      row, its emulator suite on `windows-2025`; it starts nothing and is not a required check.
      CI also runs `ios` on `macos-26`: the iOS app's unit and UI tests in a simulator against
      the in-process stub. A green CI run on main starts the apply, then the deploy and its two
      acceptance jobs, `acceptance` and `web-acceptance`, in parallel. When a web-acceptance
      sign-in step fails, the proof writes a scrubbed `sign-in-diagnostic.txt`, the leak check
      runs over it, and the run uploads the `web-acceptance-diagnostics` artifact. The iOS Live
      Proof is not in that path (HAR-170): it runs on its own, once a day and on demand, against
      whatever dev is serving, and a failure of it blocks no deploy. It never runs at the same
      time as `web-acceptance` (both sign in as the same TOTP user; one concurrency group). It
      runs the same leak check over its raw log before it uploads `ios-acceptance-screenshots`.
    '''
    include *
    include acceptance.*
    include team, meatgeek, meatgeek.web, meatgeek.mobile, entra, vercel
  }

  view deviceUpdates {
    title 'Device software updates'
    description 'How a new build reaches the Pi. Solid: today, by hand over SSH. Grey dotted: over-the-air through Device Update for IoT Hub, not built.'
    include
      operator, delivery.ci,
      meatgeek.edge.controller, meatgeek.edge.pusher, meatgeek.edge.updater,
      meatgeek.cloud.deviceupdate, meatgeek.cloud.ingest.iothub
    exclude meatgeek.edge.pusher <-> meatgeek.cloud.ingest.iothub
    exclude meatgeek.edge.pusher -> meatgeek.edge.controller
  }

  // ---- Flows ---------------------------------------------------------------

  dynamic view telemetry {
    title 'Flow: one temperature reading'
    description '''
      Today. Both paths are live. Storage: IoT Hub's `cosmos-storage-route` writes Cosmos.
      Push: Event Hub, then `broadcastTemperature`, then SignalR, addressed to the device owner,
      then the web app's live panel (see `watchCook`). The acceptance proofs are SignalR clients
      too (`signalr negotiate`, `signalr live temperature`, `signalr isolation`). Measured
      send-to-browser delay: `METRIC web-push-ms` 510 (run 44837747351); the proofs' earlier
      `signalr-delivery-ms` 18424 (run 44673261258) was a cold start. Single dev samples.
      Two correlation axes ride on each reading. `correlation.id` is cook-scoped: the device
      twin's desired `correlationId` (see `cookStart`), persisted in `cooksession` and stamped
      on every message for the whole cook. `traceparent` is per message, from the
      `publisher.publish` span; no Function reads it back.
    '''

    smoker -> meatgeek.edge.controller 'grill and probe temperatures'
    meatgeek.edge.pusher.collector -> meatgeek.edge.controller 'GET get_status' {
      notes 'Local HTTP poll of `/api/robots/MeatGeekBot/commands/get_status`, every 5 s.'
    }
    meatgeek.edge.pusher.session -> meatgeek.edge.pusher.collector 'active cook id, correlation id' {
      notes '''
        The cook id and correlation id come from one `cooksession` snapshot, the values the twin
        client last applied from the device twin's desired properties (see `cookStart`).
      '''
    }
    meatgeek.edge.pusher.collector -> meatgeek.edge.pusher.queue 'enqueue'
    meatgeek.edge.pusher.queue -> meatgeek.edge.pusher.iot 'drain'
    meatgeek.edge.pusher.tracing -> meatgeek.edge.pusher.iot 'publisher.publish span, traceparent' {
      notes 'Every message gets its own span and `traceparent` (W3C Trace Context), sampled always.'
    }
    meatgeek.edge.pusher.iot -> meatgeek.cloud.ingest.iothub 'publish (MQTT 8883, QoS 1)' {
      notes '''
        Message properties: `messageId`, `$.ct=application/json`, `$.ce=utf-8`,
        `correlation.id` (cook-scoped) and `traceparent` (per message).
        X.509 client certificate from DPS; no password, no token to renew.
      '''
    }
    parallel {
      meatgeek.cloud.ingest.iothub -> meatgeek.cloud.data.temperatures 'cosmos-storage-route' {
        notes '**Live.** IoT Hub writes the document itself, by managed identity, partition value from `{deviceid}`. No Function runs, so nothing reads `traceparent` back.'
      }
      meatgeek.cloud.ingest.iothub -> meatgeek.cloud.ingest.eventhub 'eventhub-realtime-route' {
        notes '**Live.** Every message is copied to the `temperature-data` Event Hub.'
      }
    }
    meatgeek.cloud.ingest.eventhub -> meatgeek.cloud.api.broadcast 'Event Hub trigger, consumer group api-broadcast' {
      notes '**Live.** `broadcastTemperature` (HAR-60), `cardinality: many`, identity-based. The device is the hub-stamped `iothub-connection-device-id`; the reading is mapped by `toTemperatureReading`, as `GET /temperatures/current` does, plus `enqueuedTimeUtc`.'
    }
    meatgeek.cloud.api.broadcast -> meatgeek.cloud.realtime 'each reading to its owner' {
      notes '''
        **Live.** SignalR output binding, target `temperature`, hub `temperatureHub`, `userId` =
        the device owner, read once per device per batch (HAR-81).
      '''
    }
    meatgeek.cloud.realtime -> meatgeek.web.livePanel 'temperature' {
      notes '**Live.** To the browser of the owner, when a cook detail page is open. `METRIC web-push-ms` 510 (run 44837747351).'
      navigateTo watchCook
    }
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.api.repos 'history or current reading' {
      navigateTo readHistory
    }
    meatgeek.cloud.api.repos -> meatgeek.cloud.data.temperatures 'query by deviceId'
  }

  dynamic view watchCook {
    title 'Flow: watch a cook'
    description '''
      The web app's cook detail page, live in production on Vercel. It loads the cook and its
      chart from the server-side rollups, then opens one SignalR connection and appends every
      pushed reading to the live panel and the chart. Proven live by Deploy Dev App's
      `web-acceptance` job, signed in as the acceptance test user: `METRIC web-push-ms` 510
      (run 44837747351).

      The iOS app's cook screen takes the same steps through its own components
      (`mobile.cooks`, `mobile.chart`, `mobile.livePanel`, `mobile.shell`), with MSAL for iOS
      and SignalR-Client-Swift: the same requests, the same backfill after every connect and
      reconnect, the same `waiting`, `live` and `stale` states. It also stops the connection
      when the app leaves the foreground and negotiates again on return. Proven live by the
      daily iOS Live Proof, in a simulator: `METRIC ios-push-ms` 10918 (run 45429145737), from
      the tap on Start to the pushed reading on screen, so it includes the cook start.
    '''

    pitmaster -> meatgeek.web.cooks 'open /cooks/:id'
    meatgeek.web.shell -> entra 'token (silent)' {
      notes '`acquireTokenSilent` for `access_as_user` (cache, then refresh token); every API call carries it as a bearer token.'
    }
    meatgeek.web.cooks -> meatgeek.cloud.api.cooks 'GET /cooks/{cookId}'
    meatgeek.web.chart -> meatgeek.cloud.api.cooks 'GET /cooks/{cookId}/chart' {
      notes 'Read from the rollups, never the raw readings: at most 720 points, one avg line per channel with a min/max band. A 12 h cook costs 6.19 RU (`METRIC chart-ru-12h`, budget 40).'
    }
    meatgeek.cloud.api.repos -> meatgeek.cloud.data.temperatureRollups 'one query' {
      notes 'Single-partition (partition = deviceId) over the hours the cook covers, about 13 documents for 12 h.'
    }
    meatgeek.web.livePanel -> meatgeek.cloud.api.negotiate 'POST /negotiate'
    meatgeek.web.livePanel -> meatgeek.cloud.realtime 'connect'
    meatgeek.edge.pusher.iot -> meatgeek.cloud.ingest.iothub 'reading'
    meatgeek.cloud.ingest.iothub -> meatgeek.cloud.ingest.eventhub 'eventhub-realtime-route'
    meatgeek.cloud.ingest.eventhub -> meatgeek.cloud.api.broadcast 'Event Hub trigger'
    meatgeek.cloud.api.broadcast -> meatgeek.cloud.realtime 'to the owner userId'
    meatgeek.cloud.realtime -> meatgeek.web.livePanel 'temperature' {
      notes '''
        `METRIC web-push-ms` 510 (run 44837747351), from the reading timestamp to the browser
        showing it. The panel goes `stale` after 3 x the device `pollingInterval` with no reading.
      '''
    }
    meatgeek.web.livePanel -> meatgeek.cloud.api.temperatures 'GET current (backfill after reconnect)' {
      notes 'After every connect and reconnect, so a reading missed while disconnected is shown.'
    }
    meatgeek.cloud.ingest.iothub -> meatgeek.cloud.data.temperatures 'cosmos-storage-route'
    meatgeek.cloud.data.temperatures -> meatgeek.cloud.api.rollup 'change feed'
    meatgeek.cloud.api.rollup -> meatgeek.cloud.data.temperatureRollups 'merge' {
      notes 'One etag read-merge-replace per device-hour document; at-least-once. The next chart load includes the reading.'
    }
  }

  dynamic view cookStart {
    variant sequence
    title 'Flow: start a cook'
    description '''
      POST /cooks as the code does it now. The active cook is device state: the API syncs the
      device twin's desired properties to Cosmos, and the Pi applies them and reports them back
      (HAR-58, HAR-66). The twin persists, so a Pi that is offline when the cook starts gets it
      when it next connects. `cook_started` goes to the owning user's SignalR connections, not
      to the Pi (MG-30). Sign-in (Easy Auth, then the principal) and the ownership check run
      first, as in the `api` view. Stopping a cook follows the same path: the twin's desired
      cook is cleared and `cook_stopped` goes to the owner, whose web and iOS live panels consume it.
    '''

    meatgeek.web.cooks -> meatgeek.cloud.api.cooks 'POST /cooks' {
      notes '''
        Through Easy Auth and the principal (`userId = tid:oid`; a missing header is 401). The
        web app's start form sends a client-generated id, one per intent, so a retried submit
        starts the cook once. The ownership check is one point read on `devices`: a foreign or
        unclaimed device gets 403 `DEVICE_NOT_OWNED`, with no write and no event. The live
        callers are the web app, the iOS app (the same id-per-intent rule) and the acceptance
        proofs.
      '''
    }
    meatgeek.cloud.api.cooks -> meatgeek.cloud.data.cooks 'cook and device lock' {
      notes 'One transactional batch in the caller partition: the cook and its device lock commit together, so a device holds at most one active cook (MG-84).'
    }
    meatgeek.cloud.api.cooks -> meatgeek.cloud.ingest.iothub 'set desired: activeCookId, correlationId, cookUpdatedAt' {
      notes '''
        After the write, synced to the device lock under the twin etag (`If-Match`): GET the
        twin, read the active cook from Cosmos, PATCH only if they differ, then re-read. Every
        cook PATCH stamps `cookUpdatedAt`, the API's write time (HAR-152). Managed
        identity with `IoT Hub Twin Contributor`. A failed sync answers 503
        `DEVICE_TWIN_UPDATE_FAILED`; the cook stays written and a retry of the same request
        heals the twin.
      '''
    }
    meatgeek.cloud.ingest.iothub -> meatgeek.edge.pusher.twin 'desired properties' {
      notes '''
        Delivered on connect (a full GET) or on change (a patch), so an offline Pi catches up.
        Patches apply in `$version` order. The twin client logs `applyLagMs`, the time from
        desired `cookUpdatedAt` to the apply (HAR-150, HAR-152); on a full GET it falls back to
        the twin's `$metadata`, which an MQTT patch never carries.
      '''
    }
    meatgeek.edge.pusher.twin -> meatgeek.edge.pusher.session 'persist cook, correlation id, version' {
      notes 'Written to `/var/lib/meatgeek-pusher/cooksession.json`. From then every reading carries this cook id and correlation id.'
      navigateTo telemetry
    }
    meatgeek.edge.pusher.twin -> meatgeek.cloud.ingest.iothub 'reported: applied' {
      notes '`activeCookId`, `correlationId` and `appliedDesiredVersion`: the acknowledgement. Proven live by the `device twin` acceptance proof, with the device offline when the cook starts.'
    }
    meatgeek.cloud.api.cooks -> meatgeek.cloud.realtime 'cook_started to the owning userId' {
      notes '''
        Sent only after the write succeeds, on hub `temperatureHub`, to the caller's
        `userId` ("<tid>:<oid>"), never to the deviceId (MG-30). The envelope carries
        `correlation: CorrelationContext { id }`, the same id the twin carries. The
        `signalr isolation` proof receives it as the owner. The web live panel listens for
        `temperature` and `cook_stopped`: when the cook is stopped, `cook_stopped` reaches it the
        same way and the page shows the cook as ended.
      '''
    }
  }

  dynamic view readHistory {
    variant sequence
    title 'Flow: read temperature history'
    description 'GET /temperatures/history for a device. Its live caller is the acceptance suite; the web app reads a cook through its chart (see `watchCook`), not raw history.'

    delivery.acceptance -> meatgeek.cloud.api.easyauth 'GET /temperatures/history'
    meatgeek.cloud.api.easyauth -> meatgeek.cloud.api.principal 'X-MS-CLIENT-PRINCIPAL'
    meatgeek.cloud.api.principal -> meatgeek.cloud.api.temperatures 'userId'
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.api.ownership 'does the caller own this device?'
    meatgeek.cloud.api.ownership -> meatgeek.cloud.data.devices 'point read' {
      notes '`getDeviceOwnership`. Not owned or not found: 404 `DEVICE_NOT_FOUND`, about 1 RU.'
    }
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.api.repos 'one page of readings'
    meatgeek.cloud.api.repos -> meatgeek.cloud.data.temperatures 'one page by continuation token; partition = deviceId' {
      notes '''
        `maxItemCount` = limit (at most 1000) and the continuation token from the previous page.
        No COUNT and no OFFSET since HAR-75, so a deep page costs what the first does: the volume
        proof fails unless the last page costs at most 1.5 x the first (measured 47.77 RU first,
        36.09 RU last). Measured: see `telemetryProof`.
      '''
      navigateTo telemetryProof
    }
  }

  dynamic view telemetryProof {
    variant sequence
    title 'Flow: live telemetry proof (dev acceptance)'
    description '''
      Every Deploy Dev App acceptance job proves the telemetry path end to end:
      `telemetry-roundtrip.proof.ts`, then `telemetry-volume.proof.ts`. `simdevice` sends as
      `meatgeek-dev-simulated-smoker` (MQTT 8883, X.509 client certificate, QoS 1, the data-pusher's own
      publish code); no Function is in the write path.

      Measured (single dev samples, not targets): `roundtrip-ms` 1211 (run 44603121177) and
      1235 (run 44612029684); `topup-sent`/`topup-ms` 2175 / 109996 (~19.8 readings/s, run
      44612029684). Before HAR-75 history paged by `OFFSET` and every request paid a `COUNT(1)`:
      in run 44612029684 the 100-reading page cost 11.95 RU at offset 0 and 24.12 RU at offset
      8600. Since HAR-75 it pages by continuation token with no COUNT, and the volume proof fails
      unless the last page of a walk costs at most 1.5 x the first.
    '''

    delivery.acceptance.roundtrip -> meatgeek.cloud.api.devices 'POST /devices/claim (meatgeek-dev-simulated-smoker)' {
      notes 'HAR-140: claimed with the claim code the device minted (`simdevice claim-code`), once per run and never released: 201 if the caller did not hold it, 200 if it did (`claimedAt` unchanged); later groups claim again with the same code and get 200.'
    }
    delivery.acceptance.roundtrip -> delivery.simdevice 'simdevice --count 1'
    delivery.simdevice -> meatgeek.cloud.ingest.iothub 'one reading, MQTT QoS 1' {
      notes 'Properties `messageId`, `$.ct=application/json`, `$.ce=utf-8`, `traceparent`.'
    }
    meatgeek.cloud.ingest.iothub -> meatgeek.cloud.data.temperatures 'cosmos-storage-route'
    delivery.acceptance.roundtrip -> meatgeek.cloud.api.temperatures 'GET /temperatures/current/{id}' {
      notes 'Polled every 1 s, 120 s cap, until it returns the sent reading. Prints `METRIC roundtrip-ms`: 1211 and 1235.'
    }
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.data.temperatures 'newest reading by iothub-enqueuedtime'
    delivery.acceptance.roundtrip -> meatgeek.cloud.api.temperatures 'GET /temperatures/history?startTime=...' {
      notes 'The page holds the sent reading.'
    }
    delivery.acceptance.volume -> meatgeek.cloud.api.temperatures 'GET /temperatures/history?limit=1000, page by page' {
      notes 'Walks the simulated device by continuation token, one page at a time, to count its readings.'
    }
    delivery.acceptance.volume -> delivery.simdevice 'simdevice --count N --inflight 32 --interval 50ms' {
      notes 'Only if the walk counts fewer than 8,640 (12 h at one every 5 s). N = 8,640 - counted + 60. Measured `topup-sent`/`topup-ms` 2175 / 109996, ~19.8 readings/s.'
    }
    delivery.simdevice -> meatgeek.cloud.ingest.iothub 'N readings, MQTT QoS 1'
    meatgeek.cloud.ingest.iothub -> meatgeek.cloud.data.temperatures 'cosmos-storage-route'
    delivery.acceptance.volume -> meatgeek.cloud.api.temperatures 'GET /temperatures/current/{id}, until the top-up end' {
      notes 'After a top-up only. Polled every 10 s, 15 min cap, until the current reading is at or after the reading 32 places from the top-up last.'
    }
    delivery.acceptance.volume -> meatgeek.cloud.api.temperatures 'the same walk again' {
      notes 'Prints `history-ru-first-page`, `history-ru-last-page` and `history-pages`; fails unless the last page costs at most 1.5 x the first.'
    }
    meatgeek.cloud.api.temperatures -> meatgeek.cloud.data.temperatures 'one page per request: maxItemCount + continuation token' {
      notes 'No COUNT and no OFFSET (HAR-75), so a deep page costs what the first does. The job copies every `METRIC` line into the run summary.'
    }
  }

  dynamic view mergeToDeploy {
    title 'Flow: a merge reaches dev'
    description 'What happens after the Reviewer merges a pull request. Vercel builds the web app from the same push, in parallel with the Azure path. The live iOS proof is not in this path: it is its own workflow, run once a day, and does not gate a deploy (HAR-170).'

    parallel {
      team -> delivery.ci 'merge to main' {
        notes 'The push to `main` starts CI/CD Pipeline.'
      }
      vercel -> meatgeek.web 'builds main, serves production' {
        notes 'The Vercel Git integration, on its own: no workflow and no Vercel token in GitHub. It reports back only through the `Vercel` commit status.'
      }
    }
    delivery.ci -> delivery.apply 'green on main' {
      notes '''
        `workflow_run`, so the workflow file that runs is always the one on `main`.
        If a newer commit has landed, this run ends green **without applying**.
      '''
    }
    delivery.apply -> meatgeek.cloud 'terraform apply'
    delivery.apply -> delivery.deploy 'apply succeeded'
    delivery.deploy -> meatgeek.cloud 'publish the API bundle'
    delivery.deploy -> delivery.acceptance 'deployed = true'
    delivery.acceptance -> entra 'get app-only token'
    delivery.acceptance -> meatgeek.cloud 'live probes against the API'
    delivery.acceptance -> delivery.simdevice 'spawns simdevice' {
      notes 'Live telemetry round trip and volume proofs through IoT Hub.'
      navigateTo telemetryProof
    }
    delivery.deploy -> delivery.webAcceptance 'deployed = true' {
      notes 'In parallel with `acceptance`.'
    }
    delivery.webAcceptance -> meatgeek.web 'Playwright, production' {
      notes 'Waits for `/version.json` to show this commit or a descendant (`METRIC web-deploy-wait-s`), signs in on the Microsoft pages as the test user, starts a cook on `<sim>-web` and sees a pushed reading (`METRIC web-push-ms`).'
      navigateTo watchCook
    }
  }

  dynamic view onboardDevice {
    #live
    variant sequence
    title 'Onboard a Pi: one command, DPS enrolment, claim code'
    description '''
      `apps/data-pusher/deploy/onboard-pi.sh <user@host>`, run from a checkout on the operator's
      laptop, takes a fresh Pi to a running, enrolled device and prints its claim code (HAR-144).
      The Pi makes its own key and certificate; only the public certificate leaves it. The
      laptop enrols it in DPS, then the pusher registers itself with that certificate and gets
      its IoT Hub identity. The steps follow `onboard-pi.sh` and `remote-install.sh`. See
      `docs/devices/runbook.md`.
    '''

    operator -> meatgeek.edge.pusher 'preflight, then build on the laptop' {
      notes '''
        Preflight changes nothing: Go, `az` signed in with the `azure-iot` extension, one DPS and
        one hub in the resource group (and the DPS ID scope), key-based ssh, an `aarch64` Pi with
        SPI on. A failed check prints the one command that fixes it. Then both binaries are built
        for linux/arm64 (CGO off) and copied with the units, the udev rule and
        `remote-install.sh` to `/tmp/meatgeek-onboard` on the Pi.
      '''
    }
    operator -> meatgeek.edge.pusher 'install over ssh (first sudo): identity init' {
      notes '''
        `remote-install.sh install`: the `meatgeek` user, both binaries, the udev rule, I2C, the
        systemd units, then `meatgeek-pusher identity init`, which makes the key and the
        certificate under `/var/lib/meatgeek-pusher/identity` (an existing key is kept) and
        prints only the certificate. If I2C was off, it turns it on and exits 4: reboot the Pi
        and run the same command again.
      '''
    }
    operator -> meatgeek.edge.controller 'controller started' {
      notes 'Enabled and started in the install phase; the pusher is not started yet.'
    }
    meatgeek.edge.pusher -> operator 'device.crt copied back (never the key)' {
      notes '`scp` of the public certificate only; `remote-install.sh` refuses output that holds a private key.'
    }
    operator -> meatgeek.cloud.ingest.dps 'enrol-device.sh: individual enrollment' {
      notes '''
        `az iot dps enrollment create`, X.509 attestation with that certificate, static allocation
        to the hub (`--auth-type key` by default). A revoked device is refused with exit 4;
        `REINSTATE=1` enables it again with this certificate.
      '''
    }
    operator -> meatgeek.edge.pusher 'start (second sudo): env file, pusher started' {
      notes '''
        `remote-install.sh start` writes `/etc/meatgeek-pusher/env` (0640: ID scope, device id,
        state dir, `DEVICE_URL`; no secret), then enables and restarts the pusher, and waits for
        it to register (exit 5 if it does not in time).
      '''
    }
    meatgeek.edge.pusher -> meatgeek.cloud.ingest.dps 'register (mutual TLS, device certificate)' {
      notes 'Only with no cached `assignment.json` (or after the hub refuses the certificate). The assignment is cached there.'
    }
    meatgeek.cloud.ingest.dps -> meatgeek.cloud.ingest.iothub 'create the device identity (X.509 thumbprint)' {
      notes 'By the DPS managed identity, which holds `IoT Hub Registry Contributor` on the hub.'
    }
    meatgeek.edge.pusher -> meatgeek.cloud.ingest.iothub 'MQTT connect with the certificate' {
      notes 'Port 8883, X.509 client certificate, no password.'
    }
    meatgeek.edge.pusher -> meatgeek.cloud.ingest.iothub 'twin sync: reported claimCodeHash, claimExpiresAt, claimGeneration' {
      notes 'The code stays in `<stateDir>/claim/claim.json` (0600); only its hash is reported.'
    }
    meatgeek.edge.pusher -> operator 'device id, claim code, claim URL' {
      notes '''
        The Pi's `claim-code` output reaches the laptop over ssh and is kept in a variable, never
        in a file; the laptop prints the device id, the code, its expiry and
        `<web>/devices/claim?deviceId=<id>`. The code is never in the URL or a file. An already
        claimed device prints "already claimed" instead.
        Running it again is safe: on a set-up Pi it changes nothing but restarting the pusher,
        and prints the same device id and a valid code.
      '''
      navigateTo claimDevice
    }
  }

  dynamic view claimDevice {
    #live
    variant sequence
    title 'Claim and release a device'
    description '''
      Ownership comes only from the code the device minted: `POST /devices/claim` is the only
      way a device gets an owner (HAR-133, HAR-145), and release, `DELETE /devices/{id}`, makes
      the device mint a fresh code (HAR-136). The steps follow
      `apps/api/src/functions/devices/claim-device.ts` and `delete-device.ts`. Every refusal is
      the same `403 CLAIM_REFUSED` body, which does not say which check failed. Readings from
      before the claim (`claimedAt`) are never returned to the new owner.
    '''

    pitmaster -> meatgeek.web.devices 'claim screen: /devices/claim?deviceId=, types the code'
    meatgeek.web.devices -> meatgeek.cloud.api.devices 'POST /devices/claim' {
      notes 'Through Easy Auth and the principal. A bad body is 400 before any twin or Cosmos call.'
    }
    meatgeek.cloud.api.devices -> meatgeek.cloud.ingest.iothub 'read the twin: reported hash, generation, expiry' {
      notes '''
        Refused (`403 CLAIM_REFUSED`) unless reported `claimCodeHash` is the hash of the typed
        code (constant time), reported `claimGeneration` equals desired, and `claimExpiresAt` is
        later than now. No twin is refused too. A twin failure is 503
        `DEVICE_TWIN_UPDATE_FAILED`.
      '''
    }
    meatgeek.cloud.api.devices -> meatgeek.cloud.ingest.iothub 'desired: claimConsumedCodeHash, claimClaimantHash (If-Match)' {
      notes 'Under the etag just read, so a code is single-use when two claimants race; a 412 re-reads once. A retry by the same claimant carries on.'
    }
    meatgeek.cloud.api.devices -> meatgeek.cloud.data.devices 'create the device document (claimedAt)' {
      notes 'Never an upsert. If the id exists and the caller owns it: 200 with it; owned by anyone else: refused.'
    }
    meatgeek.cloud.api.devices -> meatgeek.web.devices '201 the device'
    meatgeek.cloud.ingest.iothub -> meatgeek.edge.pusher.twin 'desired patch: consumed hash is its code' {
      notes 'The device applies the claim rule: its code is consumed, so it reports itself claimed and `claim-code` says so.'
    }
    pitmaster -> meatgeek.web.devices 'Release'
    meatgeek.web.devices -> meatgeek.cloud.api.devices 'DELETE /devices/{id}' {
      notes '409 `COOK_ACTIVE` while the caller has an active cook on the device; nothing changes. 403 `DEVICE_NOT_OWNED` for a device the caller does not own.'
    }
    meatgeek.cloud.api.devices -> meatgeek.cloud.ingest.iothub 'desired: claimGeneration + 1, claimClaimantHash null (If-Match)' {
      notes '`claimConsumedCodeHash` is kept, so the old code can never claim again. A twin failure is 503 and the document is kept, so a retry is safe.'
    }
    meatgeek.cloud.api.devices -> meatgeek.cloud.data.devices 'delete the device document' {
      notes '204. Its cooks stay in the owner history; its readings expire on the TTL.'
    }
    meatgeek.cloud.ingest.iothub -> meatgeek.edge.pusher.twin 'desired patch: new generation'
    meatgeek.edge.pusher.twin -> meatgeek.cloud.ingest.iothub 'reported: hash of a fresh code, expiry, generation' {
      notes 'The pusher mints a fresh code, writes it to `claim.json`, then reports its hash.'
    }
    meatgeek.cloud.api.broadcast -> meatgeek.cloud.api.repos 'next reading: owner lookup finds nobody' {
      notes 'Still stored by `cosmos-storage-route`, but pushed to no one and counted as `unowned`.'
    }
  }

  dynamic view revokeDevice {
    #live
    title 'Revoke a device'
    description '''
      `apps/data-pusher/deploy/revoke-device.sh --device-id <id>` (HAR-135), for a lost or stolen
      device: IoT Hub accepts nothing more from it. It deletes nothing and running it again
      changes nothing. Ownership is untouched: release the device in the web app (see
      `claimDevice`). `enrol-device.sh` with `REINSTATE=1` brings it back.
    '''

    operator -> meatgeek.cloud.ingest.dps 'revoke-device.sh: disable the enrollment' {
      notes 'The individual enrollment is set to disabled, so the device cannot register again.'
    }
    operator -> meatgeek.cloud.ingest.iothub 'disable the device identity (reason revoked)' {
      notes 'IoT Hub refuses a disabled identity at connect and drops its open connections.'
    }
    meatgeek.edge.pusher -> meatgeek.cloud.ingest.iothub 'reconnect: refused'
    meatgeek.edge.pusher -> meatgeek.cloud.ingest.dps 're-register: refused' {
      notes 'After the hub refuses it (CONNACK 4 or 5), the pusher registers again; the disabled enrollment refuses it. The device sends nothing to the cloud.'
    }
  }
}
