<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The MeatGeek app's Info.plist keys that build settings cannot generate
  (GENERATE_INFOPLIST_FILE merges this file with the generated keys).

  - CFBundleURLTypes: the msauth.<bundle id> scheme of MSAL's redirect URI
    (msauth.com.meatgeek.ios://auth).
  - CFBundleURLTypes also has the meatgeek scheme: tapping a cook's
    lock-screen activity opens meatgeek://cook/<id> (MeatGeekKit's CookLink).
  - NSSupportsLiveActivities, NSSupportsLiveActivitiesFrequentUpdates: the
    lock-screen activity (#271), held by the MeatGeekWidgets extension.
  - No LSApplicationQueriesSchemes (msauthv2/msauthv3): MSAL needs them only
    to look for the Microsoft Authenticator broker, which the app turns off
    (MSALTokenProvider, HAR-171). Sign-in is always in the system browser.
  - MeatGeek*: the sign-in and API settings from Config/Dev.xcconfig, read by
    MeatGeekKit's AppConfig.
-->
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).msal</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).cook</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>meatgeek</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>MeatGeekAPIBaseURL</key>
	<string>$(MEATGEEK_API_BASE_URL)</string>
	<key>MeatGeekTenantID</key>
	<string>$(MEATGEEK_TENANT_ID)</string>
	<key>MeatGeekClientID</key>
	<string>$(MEATGEEK_CLIENT_ID)</string>
	<key>MeatGeekAPIScope</key>
	<string>$(MEATGEEK_API_SCOPE)</string>
</dict>
</plist>
