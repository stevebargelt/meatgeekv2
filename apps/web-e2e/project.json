{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["web"],
          "target": "build"
        }
      ],
      "cache": false,
      "options": {
        "command": "playwright test -c apps/web-e2e/playwright.config.ts",
        "cwd": "."
      }
    },
    "e2e-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "playwright test -c apps/web-e2e/playwright.live.config.ts",
        "cwd": "."
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/web-e2e/jest.config.ts",
        "passWithNoTests": false
      },
      "configurations": {
        "ci": {
          "ci": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["api-specs"],
          "target": "generate-types"
        }
      ],
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript", "@playwright/test", "otplib"]
        }
      ],
      "cache": true,
      "options": {
        "commands": [
          "tsc -p apps/web-e2e/tsconfig.json --noEmit",
          "tsc -p apps/web-e2e/tsconfig.spec.json --noEmit"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": [
        {
          "projects": ["api-specs"],
          "target": "generate-types"
        }
      ]
    }
  },
  "tags": ["type:e2e", "scope:web"],
  "implicitDependencies": ["web"]
}
