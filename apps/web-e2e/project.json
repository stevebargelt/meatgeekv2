{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["web"],
          "target": "build"
        }
      ],
      "cache": false,
      "options": {
        "command": "playwright test -c apps/web-e2e/playwright.config.ts",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["api-specs"],
          "target": "generate-types"
        }
      ],
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["typescript", "@playwright/test"]
        }
      ],
      "cache": true,
      "options": {
        "command": "tsc -p apps/web-e2e/tsconfig.json --noEmit",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "dependsOn": [
        {
          "projects": ["api-specs"],
          "target": "generate-types"
        }
      ]
    }
  },
  "tags": ["type:e2e", "scope:web"],
  "implicitDependencies": ["web"]
}
